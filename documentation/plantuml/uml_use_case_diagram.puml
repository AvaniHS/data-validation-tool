@startuml Data Validation Tool - Use Case Diagram

!theme plain
skinparam usecase {
    BackgroundColor LightBlue
    BorderColor DarkBlue
    ArrowColor DarkBlue
}

title Data Validation Tool - Use Case Diagram

' Actors
actor "Data Analyst" as DA
actor "System Administrator" as SA
actor "Configuration File" as CF
actor "Input Data Files" as IDF
actor "Output Files" as OF

' System boundary
rectangle "Data Validation System" {
    
    ' Main use cases
    usecase "Configure Validation Pipeline" as UC1
    usecase "Load Configuration" as UC2
    usecase "Validate Configuration" as UC3
    usecase "Enrich Configuration" as UC4
    
    ' Data preparation use cases
    usecase "Prepare Data Frames" as UC5
    usecase "Validate File Paths" as UC6
    usecase "Load CSV Files" as UC7
    usecase "Load Excel Files" as UC8
    usecase "Clean Data" as UC9
    usecase "Remove Unnamed Columns" as UC10
    usecase "Clean Currency Values" as UC11
    usecase "Detect Join Key Types" as UC12
    usecase "Validate Data Types" as UC13
    
    ' Data joining use cases
    usecase "Join Data Frames" as UC14
    usecase "Extract Join Keys" as UC15
    usecase "Validate Join Keys" as UC16
    usecase "Perform Full Outer Join" as UC17
    usecase "Validate Join Results" as UC18
    
    ' Data aggregation use cases
    usecase "Apply Aggregation" as UC19
    usecase "Validate Aggregation Config" as UC20
    usecase "Extract Groupby Columns" as UC21
    usecase "Execute Aggregation" as UC22
    usecase "Validate Aggregation Results" as UC23
    usecase "Skip Aggregation" as UC24
    
    ' Data comparison use cases
    usecase "Compare Mapped Columns" as UC25
    usecase "Extract Column Mapping" as UC26
    usecase "Select Comparison Strategy" as UC27
    usecase "Execute Comparison" as UC28
    usecase "Calculate Differences" as UC29
    usecase "Calculate Delta Percentages" as UC30
    usecase "Validate Comparison Results" as UC31
    usecase "Skip Comparison" as UC32
    
    ' Output writing use cases
    usecase "Write Output File" as UC33
    usecase "Validate Output Config" as UC34
    usecase "Format Data" as UC35
    usecase "Write CSV File" as UC36
    usecase "Write Excel File" as UC37
    usecase "Handle File Overwrite" as UC38
    usecase "Validate Output Results" as UC39
    
    ' Factory and dependency injection use cases
    usecase "Create Data Reader" as UC40
    usecase "Create Data Writer" as UC41
    usecase "Create File Validator" as UC42
    usecase "Resolve Dependencies" as UC43
    usecase "Initialize Pipeline Orchestrator" as UC44
    
    ' Error handling use cases
    usecase "Handle Configuration Errors" as UC45
    usecase "Handle File Not Found" as UC46
    usecase "Handle Data Validation Errors" as UC47
    usecase "Handle Join Errors" as UC48
    usecase "Handle Aggregation Errors" as UC49
    usecase "Handle Comparison Errors" as UC50
    usecase "Handle Output Errors" as UC51
    
    ' Pipeline orchestration use cases
    usecase "Execute Complete Pipeline" as UC52
    usecase "Monitor Pipeline Progress" as UC53
    usecase "Generate Execution Summary" as UC54
    usecase "Handle Pipeline Failures" as UC55
    
    ' Interactive mode use cases
    usecase "Run Interactive Mode" as UC56
    usecase "Get User Input" as UC57
    usecase "Display Sample Configuration" as UC58
    usecase "Validate User Input" as UC59
    
    ' Future extensibility placeholders
    usecase "Extend File Formats" as UC60
    usecase "Add New Aggregation Types" as UC61
    usecase "Add New Comparison Strategies" as UC62
    usecase "Add New Output Formats" as UC63
    usecase "Add Custom Validators" as UC64
    usecase "Add Performance Monitoring" as UC65
    usecase "Add Logging and Auditing" as UC66
}

